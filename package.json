{
  "name": "mcp-hub",
  "version": "0.1.0",
  "private": true,
  "description": "MCP Hub — 一个域名托管多个 MCP 服务，让 AI Agent 直接调用你的工具",
  "author": {
    "name": "IceyWu",
    "url": "https://github.com/IceyWu"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/IceyWu/mcp-hub"
  },
  "license": "MIT",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "build:mcp": "pnpm --filter tencent-docs-mcp build && pnpm --filter wordsessence-mcp build && pnpm --filter levwu-mcp build",
    "dev:web": "pnpm --filter web dev",
    "dev:wordsessence": "pnpm --filter wordsessence-mcp dev",
    "dev:levwu": "pnpm --filter levwu-mcp dev",
    "build:web": "pnpm --filter web build",
    "dev": "eve dev",
    "start": "eve start",
    "typecheck": "tsc",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "release": "pnpm --filter tencent-docs-mcp run build && changeset publish"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.28",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@vercel/connect": "0.7.0",
    "ai": "^7.0.62",
    "eve": "^0.33.2",
    "express": "5.2.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "~24.13.3",
    "just-bash": "^3.2.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "24.x"
  }
}
