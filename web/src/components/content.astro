---
const { configText, copyText, githubUrl } = Astro.props;
const text = copyText ?? configText;
---

<div class="code-wrap" data-copy-text={text}>
  <div class="code-block">
    <pre><code set:html={configText} /></pre>
    <button class="copy-btn" aria-label="Copy to clipboard">
      <svg
        class="copy-icon"
        width="16"
        height="16"
        viewBox="0 0 16 16"
        fill="none"
      >
        <rect
          x="5"
          y="5"
          width="9"
          height="9"
          rx="1.5"
          stroke="currentColor"
          stroke-width="1.5"></rect>
        <path
          d="M11 5V3.5C11 2.67157 10.3284 2 9.5 2H3.5C2.67157 2 2 2.67157 2 3.5V9.5C2 10.3284 2.67157 11 3.5 11H5"
          stroke="currentColor"
          stroke-width="1.5"></path>
      </svg>
      <svg
        class="check-icon"
        width="16"
        height="16"
        viewBox="0 0 16 16"
        fill="none"
        style="display:none"
      >
        <path
          d="M3 8L6 11L13 4"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </button>
  </div>
  {githubUrl && <a href={githubUrl} class="gh-link" target="_blank" rel="noopener noreferrer">View on GitHub →</a>}
</div>

<script>
  document.querySelectorAll(".copy-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const copyIcon = btn.querySelector(".copy-icon");
      const checkIcon = btn.querySelector(".check-icon");
      const configToCopy = btn.closest<HTMLElement>(".code-wrap")?.dataset.copyText ?? "";
      try {
        await navigator.clipboard.writeText(configToCopy);
        if (copyIcon) (copyIcon as HTMLElement).style.display = "none";
        if (checkIcon) (checkIcon as HTMLElement).style.display = "block";
        btn.classList.add("copied");
        setTimeout(() => {
          if (copyIcon) (copyIcon as HTMLElement).style.display = "block";
          if (checkIcon) (checkIcon as HTMLElement).style.display = "none";
          btn.classList.remove("copied");
        }, 2000);
      } catch {
        // fallback silently
      }
    });
  });
</script>
