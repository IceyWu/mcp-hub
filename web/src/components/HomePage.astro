---
import type { Translations } from "../i18n/translations";
import CodeBlock from "./content.astro";
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";

interface Props {
  t: Translations;
  locale: string;
}

const { t, locale } = Astro.props;
const serviceBase = locale === "zh-CN" ? "/services" : "/en/services";
const cardLabels = locale === "zh-CN"
  ? { tools6: "6 个工具", tools5: "5 个工具", auth: "Header 鉴权", write: "支持写入" }
  : { tools6: "6 tools", tools5: "5 tools", auth: "Header auth", write: "Write capable" };

const mcpConfigLines = [
  "{",
  '  "mcpServers": {',
  '    "tencent-docs": {',
  '      "type": "http",',
  '      "url": "https://mcp.iceywu.cn/tencent-docs/",',
  '      "headers": {',
  '        "x-tencent-client-id": "&lt;your-id&gt;",',
  '        "x-tencent-access-token": "&lt;your-token&gt;",',
  '        "x-tencent-open-id": "&lt;your-open-id&gt;"',
  "      }",
  "    },",
  '    "wordsessence": {',
  '      "type": "http",',
  '      "url": "https://mcp.iceywu.cn/wordsessence/"',
  "    }",
  "  }",
  "}",
];
const mcpConfig = mcpConfigLines.join("\n");
const mcpConfigCopy = `{
  "mcpServers": {
    "tencent-docs": {
      "type": "http",
      "url": "https://mcp.iceywu.cn/tencent-docs/",
      "headers": {
        "x-tencent-client-id": "<your-id>",
        "x-tencent-access-token": "<your-token>",
        "x-tencent-open-id": "<your-open-id>"
      }
    },
    "wordsessence": {
      "type": "http",
      "url": "https://mcp.iceywu.cn/wordsessence/"
    }
  }
}`;
---

<SiteHeader locale={locale} role={t.role} />

<main class="main">
  <h1 class="title">{t.title}</h1>
  <p class="desc">{t.desc}</p>
  <p class="usage">{t.usage}</p>

  <CodeBlock
    configText={mcpConfig}
    copyText={mcpConfigCopy}
  />

  <section class="section">
    <h2 class="section-title">{t.services}</h2>
    <div class="cards">
      <a href={`${serviceBase}/tencent-docs/`} class="card">
        <span class="card-top"><span class="card-title">{t.service1Name}</span><span class="card-arrow">→</span></span>
        <span class="card-desc">{t.service1Desc}</span>
        <span class="card-detail">{t.service1Detail}</span>
        <span class="service-meta"><span class="pill">Streamable HTTP</span><span class="pill">{cardLabels.tools6}</span><span class="pill">{cardLabels.auth}</span></span>
      </a>
      <a href={`${serviceBase}/wordsessence/`} class="card">
        <span class="card-top"><span class="card-title">{t.service2Name}</span><span class="card-arrow">→</span></span>
        <span class="card-desc">{t.service2Desc}</span>
        <span class="card-detail">{t.service2Detail}</span>
        <span class="service-meta"><span class="pill">Streamable HTTP</span><span class="pill">{cardLabels.tools5}</span><span class="pill">{cardLabels.write}</span></span>
      </a>
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">{t.howTitle}</h2>
    <p class="how-desc">{t.howDesc}</p>
  </section>

  <section class="section">
    <h2 class="section-title">{t.moreTitle}</h2>
    <p class="iceberg-desc">{t.moreDesc}</p>
    <a href="https://github.com/IceyWu/mcp-hub" class="cta">
      {t.viewOnGitHub}
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
        <path
          d="M6 12L10 8L6 4"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </a>
  </section>
</main>

<SiteFooter text={t.footerText} />
